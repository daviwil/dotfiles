;;; Tessera configuration for David's machines, following the Sway config
;;; next to it (~/.config/sway/config). Tessera loads this file at startup
;;; as ~/.config/tessera/config.sgl, or the file $TESSERA_CONFIG names;
;;; its last expression is the configuration.
(import (tessera config)
        (tessera bar)
        (tessera layouts grid))

;; Docks rename the external display, so "primary" is every connector it
;; has shown up as.
(define primary '("DP-11" "DP-2" "DP-3" "DP-4" "DP-7" "DP-8" "HDMI-A-1"))
(define laptop "eDP-1")

;; Workspace 1 starts as a 2x2 grid on zerocool, as its Sway setup builds
;; a 2x2 terminal grid there.
(define workspace-1-layout
  (and (equal? (system-name) "zerocool") (grid-layout '(2 2))))

(define workspaces
  (list (workspace "0" (list laptop))
        (workspace "1" (list primary laptop) workspace-1-layout)
        (workspace "2" (list primary laptop))
        (workspace "3" (list "DP-2" primary laptop))
        (workspace "4" (list "DP-2" laptop))
        (workspace "5" (list laptop))))

;; Sway's background: samuel-ferrara, and scott-rodgerson on acidburn and
;; zerocool, as their Sway system files set it.
(define background
  (if (member (system-name) '("acidburn" "zerocool"))
      "~/.dotfiles/backgrounds/scott-rodgerson-lRtzEExP0H8-unsplash.jpg"
      "~/.dotfiles/backgrounds/samuel-ferrara-uOi3lg8fGl4-unsplash.jpg"))

;; Sway's output lines, every output at scale 2.
(define outputs
  (list (output "*" scale: 2 background: background background-mode: 'fill)
        (output "DP-3" position: '(0 0))
        (output "DP-4" position: '(0 0))
        (output "DP-7" position: '(0 0))
        (output "DP-8" position: '(0 0))
        (output "DP-11" position: '(0 0))
        (output "DP-2" position: '(1920 0))
        (output "HDMI-A-1" position: '(1920 0))
        (output laptop position: '(1920 1080))
        (output "DP-9" position: '(1920 0) transform: 270)
        (output "DP-10" position: '(1920 0) transform: 270)))

;; Workspace 0 also sits on grave and Escape, Mod+Control+l locks,
;; Mod+space opens fuzzel with Sway's colors, and Mod+Shift+s turns the
;; primary displays off and on, as toggle-display does under Sway. These
;; replace any default binding on the same chord, since a repeated chord
;; makes Tessera reject the whole config.
(define keymap-overrides
  (append '(("Mod+space" exec "fuzzel" "-w" "50" "-x" "8" "-y" "8" "-r" "3"
             "-b" "232635ff" "-t" "A6Accdff" "-s" "A6Accdff" "-S" "232635ff"
             "-C" "c792eacc" "-m" "c792eacc"
             "-f" "JetBrains Mono:weight=light:size=10"
             "--icon-theme=Papirus-Dark" "--no-exit-on-keyboard-focus-loss")
            ("Mod+Shift+e" exec "foot" "-f" "JetBrains Mono:size=11" "emacsclient" "-a" "" "-t")
            ("XF86MonBrightnessDown" exec "brightnessctl" "set" "5%-")
            ("XF86MonBrightnessUp" exec "brightnessctl" "set" "5%+")
            ("Mod+p" exec "playerctl" "play-pause")
            ("Mod+grave" workspace "0")
            ("Mod+Escape" workspace "0")
            ("Mod+Shift+grave" move-to-workspace "0")
            ("Mod+Shift+Escape" move-to-workspace "0")
            ("Mod+Control+l" lock))
          (list (cons "Mod+Shift+s" (cons 'output-toggle primary)))))

(define keymap
  (append (filter (lambda (binding) (not (assoc (car binding) keymap-overrides)))
                  (config-keymap default-config))
          keymap-overrides))

;; Sway's input blocks: US and Greek layouts with Caps as Control, and
;; the laptop touchpad's tap, disable-while-typing and middle-button
;; emulation. Mod+Shift+space switches layout.
(define keyboard-settings (keyboard layout: "us,gr" options: "ctrl:nocaps"))
(define touchpad-settings (touchpad tap: #t dwt: #t middle-emulation: #t))

;; Sway's bar: top, shown only while Mod is held (its "mode hide"), in
;; JetBrains Mono 8 on Sway's $bgcolor, with Sway's date and time format
;; on the right.
;; Orpiment: the bar. Opaque bg1, as the house style's overlay is opaque.
;; Bar colours are straight RGBA.
(define house-bar-style
  (bar-style font: "JetBrains Mono 8"
             background: #x141412ff   ; bg1
             foreground: #xe6e2d5ff   ; fg0
             padding: '(0 8 0 8)))
;; The workspace names: focused on the focus colour, visible ones in the focus colour on bg3,
;; urgent in the D27 red, the rest in fg2.
(define house-workspaces
  (workspaces-section
    style: (bar-style background: #x141412ff foreground: #x989485ff)
    focused-style: '((background . #xedbb45ff) (foreground . #x0e0e0cff))
    visible-style: '((background . #x2a2922ff) (foreground . #xedbb45ff))
    urgent-style: '((background . #xff5370ff) (foreground . #x0e0e0cff))))

(define status-bar
  (bar position: 'top
       outputs: '("*")
       visibility: 'overlay
       style: house-bar-style
       ;; Sway's inactive_workspace colors for workspaces not on screen.
       left: (list house-workspaces
                   (layout-section))
       right: (list (network-section)
                    (drives-section)
                    (clock-section format: "%Y-%m-%d %I:%M:%S %p W%U"
                                   interval: 1))))

(config-with default-config
  bar: status-bar
  workspaces: workspaces
  outputs: outputs
  keymap: keymap
  keyboard: keyboard-settings
  touchpad: touchpad-settings
  start-workspace: "1"
  focused-border: #xedbb45ff
  focused-inactive-border: #x4c493eff
  unfocused-border: #x252420ff
  title-focused: #xe6e2d5ff
  title-focused-inactive: #xe6e2d5ff
  title-unfocused: #xaba79aff
  title-background: #x111110dd)
