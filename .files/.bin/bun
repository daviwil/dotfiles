#!/bin/sh

# Wrapper for Bun's native binary on Guix.  The binary at
# ~/.local/bin/bun is dynamically linked and expects an FHS
# interpreter path, so we use patchelf to fix it before running.

BUN=$HOME/.local/bin/bun

exec guix shell \
  patchelf glibc \
  -- sh -c '
    INTERP=$(patchelf --print-interpreter $(which bash))
    CURRENT=$(patchelf --print-interpreter "'"$BUN"'" 2>/dev/null || echo "")
    if [ "$CURRENT" != "$INTERP" ]; then
      echo "Patching bun interpreter..."
      patchelf --set-interpreter "$INTERP" "'"$BUN"'"
    fi
    exec "'"$BUN"'" "$@"
  ' _ "$@"
